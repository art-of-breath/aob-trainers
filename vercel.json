{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/graduates",
      "destination": "/breathwork-verzeichnis",
      "permanent": true
    },
    {
      "source": "/graduates.html",
      "destination": "/breathwork-verzeichnis",
      "permanent": true
    }
  ]
}
